{
  "name": "bayanihubmobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios --non-interactive",
    "ios:build": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "test": "npm run test:unit",
    "test:unit": "jest --coverage --ci --passWithNoTests",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run doctor",
    "android:prebuild": "expo prebuild --platform android --non-interactive",
    "maestro:validate": "tsx ./scripts/validate-maestro-flows.ts",
    "maestro:test": "maestro test .maestro",
    "maestro:test:android": "maestro test .maestro/smoke-android.yaml",
    "maestro:test:ios": "maestro test .maestro/smoke-ios.yaml",
    "test:e2e": "npm run maestro:validate && npm run maestro:test"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.26",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-document-picker": "~55.0.13",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "^25.5.0",
    "@types/react": "~19.2.14",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.18",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
